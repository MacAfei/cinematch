# CineMatch Secrets Configuration (Template)
# -------------------------------------------------------------
# For Local Development:
# Copy this file to .streamlit/secrets.toml and enter your TMDb API Key.
#
# For Streamlit Community Cloud (Hosted):
# Paste the line below into your App Settings -> Secrets at share.streamlit.io.
#
# Get a free key at: https://www.themoviedb.org/settings/api

TMDB_API_KEY = "your_tmdb_api_key_here"
